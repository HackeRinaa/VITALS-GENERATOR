MQTT_URL=mqtt://localhost:1883
MQTT_USER=generator-client
MQTT_PASS=replace-with-generator-password

# Optional behavior tuning
MQTT_QOS=1
MQTT_RETAIN=false
MQTT_RECONNECT_MS=1500
INTERVAL_MS=20000

# Use one source id, or a comma-separated list.
# MQTT_SOURCE_IDS takes precedence if both are set.
MQTT_SOURCE_ID=sim-01
# MQTT_SOURCE_IDS=sim-01,sim-02

# Set false if broker ACL does not allow subscribe to in.vitals.gen/control/+
ENABLE_CONTROL_SUBSCRIPTION=true
